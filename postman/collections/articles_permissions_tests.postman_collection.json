{
  "info": {
    "_postman_id": "8f3e21a4-991d-400a-b5e1-88997a32d110",
    "name": "Person 1 - Articles & Categories Permissions Tests",
    "description": "اختبارات التقييم للميزة الأولى: إدارة المحتوى والأقسام واختبار قيود الصلاحيات 403 والنجاح 200/201 للأدوار المختلفة (User, Author, Editor, Admin)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01. Login as Regular User (User Role)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Accept", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"email\": \"user@example.com\",\n    \"password\": \"password\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/login",
          "host": ["{{baseUrl}}"],
          "path": ["api", "login"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData = pm.response.json();",
              "if (jsonData.status && jsonData.data && jsonData.data.access_token) {",
              "    pm.environment.set('user_token', jsonData.data.access_token);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "02. User Attempts Create Category (Expect 403 Forbidden)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{user_token}}" },
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Accept", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"name\": \"قسم غير مصرح\",\n    \"slug\": \"unauthorized-category\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/categories",
          "host": ["{{baseUrl}}"],
          "path": ["api", "categories"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 403 Forbidden', function () {",
              "    pm.response.to.have.status(403);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "03. User Attempts Create Article (Expect 403 Forbidden)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{user_token}}" },
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Accept", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"title\": \"مقال من مستخدم عادي\",\n    \"content\": \"محتوى غير مصرح به\",\n    \"category_id\": 1\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/articles",
          "host": ["{{baseUrl}}"],
          "path": ["api", "articles"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 403 Forbidden', function () {",
              "    pm.response.to.have.status(403);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "04. Login as Author (Author Role)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Accept", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"email\": \"author@example.com\",\n    \"password\": \"password\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/login",
          "host": ["{{baseUrl}}"],
          "path": ["api", "login"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData = pm.response.json();",
              "if (jsonData.status && jsonData.data && jsonData.data.access_token) {",
              "    pm.environment.set('author_token', jsonData.data.access_token);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "05. Author Successfully Creates Article (Expect 201 Created)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{author_token}}" },
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Accept", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"title\": \"مقال صحفي بقلم الكاتب\",\n    \"content\": \"تفاصيل هذا المقال تمت كتابتها بواسطة كاتب معتمد.\",\n    \"category_id\": 1,\n    \"status\": \"draft\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/articles",
          "host": ["{{baseUrl}}"],
          "path": ["api", "articles"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 201 Created', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "var jsonData = pm.response.json();",
              "if (jsonData.data && jsonData.data.id) {",
              "    pm.environment.set('created_article_id', jsonData.data.id);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "06. Author Attempts Edit Other Author's Article (Expect 403 Forbidden)",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Authorization", "value": "Bearer {{author_token}}" },
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Accept", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"title\": \"محاولة تعديل مقال كاتب آخر\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/articles/9999",
          "host": ["{{baseUrl}}"],
          "path": ["api", "articles", "9999"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 403 or 404', function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([403, 404]);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
